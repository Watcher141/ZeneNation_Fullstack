# =============================================================================
#  ZENENATION PRODUCTION ENVIRONMENT CONFIGURATION (.env)
#  Copy this file to .env and fill in your actual values
#  DO NOT COMMIT the .env file — only this .env.example
# =============================================================================

# Database
POSTGRES_DB=ecommerce_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# JWT
JWT_SECRET=CHANGE_ME_generate_a_64_char_hex_string
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (SMTP / Brevo)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-smtp-username
MAIL_PASSWORD=your-brevo-smtp-key

# Email (Resend API)
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM=Zenenation <noreply@zenenation.in>

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Frontend / Domain URLs
FRONTEND_URL=https://zenenation.in
OAUTH2_REDIRECT_URI=https://zenenation.in/oauth2/callback

# Default Admin credentials
ADMIN_EMAIL=admin@zenenation.com
ADMIN_PASSWORD=CHANGE_ME_strong_password
